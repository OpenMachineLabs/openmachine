{
  "name": "motion-studio-contextual-retrieval-film",
  "version": "1.0.0",
  "private": true,
  "description": "Pinned editable Remotion pilot plus original subject-specific Motion Studio films",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ContextualRetrieval out/contextual-retrieval.mp4",
    "still": "remotion still src/index.ts ContextualRetrieval out/poster.png --frame=470",
    "typecheck": "tsc --noEmit",
    "preview": "remotion render src/index.ts ContextualRetrieval out/mechanism-preview.mp4 --frames=310-579",
    "direction-b": "remotion still src/index.ts DirectionB out/direction-b.png",
    "nine-hours-render": "remotion render src/index.ts NineHoursEngineering out/nine-hours-engineering.mp4",
    "nine-hours-preview": "remotion render src/index.ts NineHoursEngineering out/nine-hours-preview.mp4 --frames=320-589",
    "nine-hours-still": "remotion still src/index.ts NineHoursEngineering out/nine-hours-poster.png --frame=90",
    "nine-hours-alt": "remotion still src/index.ts NineHoursAlt out/nine-hours-alt.png",
    "nine-hours-direction-a": "remotion still src/index.ts NineHoursEngineering out/nine-hours-direction-a.png --frame=470"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "remotion": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
